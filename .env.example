# BBLS Client Portal — local development only
# Copy to `.env` and replace placeholders. Never commit real secrets.
# Do not use Stripe live keys. This project refuses sk_live_ credentials.

APP_ORIGIN=http://127.0.0.1:4173
PORTAL_DB_PATH=./data/portal.db
PORTAL_UPLOAD_DIR=./data/uploads
SESSION_SECRET=bbls-local-dev-session-secret-not-for-production
ADMIN_EMAIL=admin@bbls.studio
ADMIN_PASSWORD=S@f@1371
ADMIN_NAME=BBLS Studio

# Stripe Test Mode only. Leave blank to use the local mock checkout.
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Emails are logged to the database in development. Do not send real mail.
EMAIL_MODE=log
BBLS_EMAIL=hello@bbls.studio
BBLS_PHONE=(949) 524-2324

# Signed unsubscribe (must match lead agent UNSUBSCRIBE_SECRET).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real secret. Set the same value in Vercel project env for production.
UNSUBSCRIBE_SECRET=
# Optional override for suppression JSON path (defaults to ./data/email-suppressions.json)
# UNSUBSCRIBE_STORE_PATH=

# --- Booking (/book) — Google Calendar OAuth (server-side only) ---
# Run: node scripts/google-calendar-auth.mjs  (after creating an OAuth Desktop client)
# Then paste the printed values into Vercel env. Never put these in client code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Optional host email copied on events
# BOOKING_HOST_EMAIL=hello@bbl.studio

# Booking windows (defaults shown). Duration is configurable — do not hard-code elsewhere.
BOOKING_TIMEZONE=America/Los_Angeles
BOOKING_TIMEZONE_LABEL=Pacific Time (PT)
BOOKING_DURATION_MINUTES=30
BOOKING_MIN_NOTICE_HOURS=48
BOOKING_MAX_DAYS_AHEAD=28
BOOKING_SLOT_INTERVAL_MINUTES=30
BOOKING_WORK_DAYS=1,2,3,4,5
BOOKING_WORK_START_HOUR=10
BOOKING_WORK_END_HOUR=16

# Transactional booking confirmation only (separate from lead outreach).
# log = console only (default). send = Resend when RESEND_API_KEY is set.
# Do NOT set EMAIL_OUTREACH_ENABLED or change EMAIL_DRY_RUN for booking.
BOOKING_EMAIL_MODE=log
# BOOKING_EMAIL_FROM=hello@bbl.studio
# RESEND_API_KEY=   # reuse existing key if already on Vercel; do not overwrite unnecessarily

