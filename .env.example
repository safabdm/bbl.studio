# BBL Client Portal — local development only
# Copy to `.env` and replace placeholders. Never commit real secrets.
# Do not use Stripe live keys. This project refuses sk_live_ credentials.

APP_ORIGIN=http://127.0.0.1:4173
PORTAL_DB_PATH=./data/portal.db
PORTAL_UPLOAD_DIR=./data/uploads
# Local-only defaults below. On Vercel/production these MUST be unique strong
# values — the server refuses example defaults and does not fall back to them.
SESSION_SECRET=bbls-local-dev-session-secret-not-for-production
ADMIN_EMAIL=hello@bbl.studio
ADMIN_PASSWORD=S@f@1371
ADMIN_NAME=BBL Studio

# Stripe Test Mode only. Leave blank to use the local mock checkout.
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Emails are logged to the database in development. Do not send real mail.
EMAIL_MODE=log
# Prefer BBL_*; code also accepts legacy BBLS_* (do not rename live Vercel secrets yet).
BBL_EMAIL=hello@bbl.studio
BBL_PHONE=(949) 524-2324
# BBLS_EMAIL=
# BBLS_PHONE=

# Signed unsubscribe (must match lead agent UNSUBSCRIBE_SECRET).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real secret. Set the same value in Vercel project env for production.
UNSUBSCRIBE_SECRET=
# Optional override for suppression JSON path (defaults to ./data/email-suppressions.json)
# UNSUBSCRIBE_STORE_PATH=

# Consultation booking. Duration is minutes. Times are Pacific unless BOOKING_TIMEZONE changes.
# CONSULTATION_MINUTES=30
# BOOKING_TIMEZONE=America/Los_Angeles
# BOOKING_START_MINUTES=600
# BOOKING_END_MINUTES=960
# BOOKING_WEEKDAYS=1,2,3,4,5
# GOOGLE_CALENDAR_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# Transactional booking mail only. Separate from lead outreach.
# RESEND_API_KEY=
# RESEND_FROM=BBL Studio <hello@bbl.studio>
# CRON_SECRET=

# --- CRM / email marketing dashboard (manual send only) ---
# Automated outreach must stay OFF. Dry-run is the default.
EMAIL_OUTREACH_ENABLED=false
EMAIL_DRY_RUN=true
# Live ESP campaign sends require this explicit flag (keep false).
MANUAL_SEND_LIVE_ENABLED=false
# Follow-ups never live from this website surface.
FOLLOWUPS_LIVE=false

# Mac → website push sync (outbound-only). Same secret on Mac + Vercel.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# CRM_SYNC_SECRET=
# Alias accepted by ingest auth (prefer CRM_SYNC_SECRET):
# LEAD_AGENT_CRM_SECRET=

# Durable CRM store (REQUIRED on Vercel). Neon / Vercel Postgres connection string.
# Server-side only — never expose to the browser.
# Create via Vercel Marketplace → Neon, or neon.tech, then paste the pooled URL:
# CRM_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL=   # accepted as fallback alias for CRM_DATABASE_URL
# Local without Postgres falls back to ./data/crm-sync-snapshot.json
# CRM_SYNC_STORE_PATH=
# Hours after which a sync is labeled Sync pending / stale (default 48)
# CRM_SYNC_STALE_HOURS=48

# Pull-from-Mac is retired — do not expose Mac/SQLite publicly.
# LEAD_AGENT_CRM_BASE_URL=   # unused; kept only for older docs

# Resend webhook ingress on website (updates CRM snapshot in place).
# Optional forward if a public lead host exists later (usually unset).
# RESEND_WEBHOOK_SECRET=
# LEAD_AGENT_RESEND_WEBHOOK_URL=
# Optional local paths for drafts / dry-run send log / webhook idempotency.
# CRM_DRAFTS_PATH=./data/crm-campaign-drafts.json
# CRM_SEND_LOG_PATH=./data/crm-send-log.json
# RESEND_WEBHOOK_IDEMPOTENCY_PATH=./data/resend-webhook-events.json
