{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "seed": "tsx server/seed.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test:unsubscribe": "tsx --test server/unsubscribe.test.ts",
    "test:booking": "tsx --test server/booking.test.ts",
    "test:crm": "tsx --test server/crm-safety.test.ts server/crm-campaigns.test.ts server/outreach-policy.test.ts server/preview-token.test.ts server/resend-send.test.ts server/freelance-score.test.ts server/resend-webhook.test.ts server/crm-freshness.test.ts server/crm-sync.test.ts server/crm-esm-imports.test.ts server/crm-discovery.test.ts server/outreach-studio.test.ts server/daily-20.test.ts server/daily-outreach-scheduler.test.ts server/pacific-time.test.ts",
    "test:outreach-studio": "tsx --test server/outreach-studio.test.ts server/daily-20.test.ts server/daily-outreach-scheduler.test.ts server/pacific-time.test.ts",
    "test:admin-auth": "tsx --test api/admin-auth.test.ts server/admin-auth.test.ts api/crm-sync-auth.test.ts",
    "test:routing": "tsx --test server/public-routing.test.ts",
    "test:serverless-init": "tsx --test server/project-root.test.ts server/crm-esm-imports.test.ts",
    "test:crm-all": "pnpm test:unsubscribe && pnpm test:booking && pnpm test:crm && pnpm test:admin-auth && pnpm test:serverless-init"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hono/node-server": "^2.1.1",
    "@neondatabase/serverless": "^1.2.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "hono": "^4.13.5",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-router-dom": "^7.18.3",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "stripe": "^22.6.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
